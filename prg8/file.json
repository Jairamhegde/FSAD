// Step 2: Create text index
db.catalog.createIndex({
  name: "text",
  description: "text",
  tags: "text"
})
// Step 3: Execute aggregation pipeline
db.catalog.aggregate([
    {
    $match: {
      $text: {
        $search: "durable backpack"
            }
        }
    },
    {
    $project: {
      _id: 0,
      name: 1,
      price: 1,
      score: { $meta: "textScore"
            }
        }
    }
])
